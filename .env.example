# Supabase project settings → API. The anon/publishable key is safe to ship to
# browsers: row-level security in the database is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Google OAuth web client ID (public, ends in .apps.googleusercontent.com).
# Enables the Google Calendar panel. Never put the client secret here.
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
