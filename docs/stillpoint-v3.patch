+  { id: 'stylist', category: 'explorer', metric: (c) => c.themesTried.length, describe: (t) => `Try ${t} different themes.`,
+    tiers: [[2, 'Window Shopper'], [4, 'Stylist'], [8, 'Shape Shifter'], [13, 'Collector of Worlds']] },
