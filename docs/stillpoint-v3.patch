@@ -0,0 +1,66 @@
+import { useEffect } from 'react'
+import { CATEGORY_LABEL } from '../../game/achievements'
+import { useGame } from '../../game/GameProvider'
+import { useVibe } from '../../themes/vibe'
+import { Badge, RARITY_COLOR } from './Badge'
+
+/**
+ * The one loud moment in a quiet app: an achievement or level-up card that
+ * pops in, glows in its rarity colour, and gets out of the way.
+ */
+export function Celebration() {
+  const { queue, dismiss } = useGame()
+  const vibe = useVibe()
+  const item = queue[0]
+
+  useEffect(() => {
+    if (!item) return
+    const t = setTimeout(dismiss, item.kind === 'level' ? 4200 : 3400)
+    return () => clearTimeout(t)
+  }, [item, dismiss])
+
+  if (!item) return null
+  const color = item.kind === 'level' ? 'var(--accent-sand)' : RARITY_COLOR[item.a.rarity]
+
+  return (
+    <div className="pointer-events-none fixed inset-x-0 top-4 z-[60] flex justify-center px-4" aria-live="assertive">
+      <button
+        key={item.kind === 'level' ? `lvl-${item.level}` : item.a.id}
+        onClick={dismiss}
+        className="celebration anim-pop pointer-events-auto relative flex w-full max-w-sm items-center gap-4 overflow-hidden rounded-2xl border bg-surface px-4 py-3.5 text-left shadow-2xl"
+        style={{ borderColor: color, boxShadow: `0 0 0 1px ${color}, 0 18px 50px -12px ${color}` }}
+      >
+        <span aria-hidden="true" className="celebration-rays absolute -left-10 top-1/2 size-40 -translate-y-1/2 rounded-full opacity-25" style={{ background: `conic-gradient(from 0deg, ${color} 0 10deg, transparent 10deg 30deg, ${color} 30deg 40deg, transparent 40deg 60deg, ${color} 60deg 70deg, transparent 70deg 90deg, ${color} 90deg 100deg, transparent 100deg 120deg, ${color} 120deg 130deg, transparent 130deg 150deg, ${color} 150deg 160deg, transparent 160deg 180deg, ${color} 180deg 190deg, transparent 190deg 210deg, ${color} 210deg 220deg, transparent 220deg 240deg, ${color} 240deg 250deg, transparent 250deg 270deg, ${color} 270deg 280deg, transparent 280deg 300deg, ${color} 300deg 310deg, transparent 310deg 330deg, ${color} 330deg 340deg, transparent 340deg)` }} />
+        {item.kind === 'level' ? (
+          <>
+            <span className="relative grid size-14 shrink-0 place-items-center rounded-full font-display text-2xl font-semibold text-bg" style={{ background: color }}>
+              {item.level}
+            </span>
+            <span className="relative">
+              <span className="block text-[12px] tracking-wide text-muted">{vibe.levelUp}</span>
+              <span className="block font-display text-xl font-medium text-ink">
+                {vibe.level} {item.level}
+              </span>
+              <span className="block text-[13px] text-ink-2">You are now: {item.title}</span>
+            </span>
+          </>
+        ) : (
+          <>
+            <span className="relative">
+              <Badge rarity={item.a.rarity} category={item.a.category} size={56} />
+            </span>
+            <span className="relative min-w-0">
+              <span className="block text-[12px] tracking-wide" style={{ color }}>
+                {vibe.unlocked} ({item.a.rarity})
+              </span>
+              <span className="block truncate font-display text-lg font-medium text-ink">{item.a.name}</span>
+              <span className="block text-[12px] text-muted">
+                {CATEGORY_LABEL[item.a.category]}, +{item.a.xp} {vibe.xp}
+              </span>
+            </span>
+          </>
+        )}
+      </button>
+    </div>
+  )
+}
diff --git a/src/components/game/HeroPanel.tsx b/src/components/game/HeroPanel.tsx
new file mode 100644
index 0000000..605948b
--- /dev/null
+++ b/src/components/game/HeroPanel.tsx
@@ -0,0 +1,110 @@
+import { useState } from 'react'
+import { ATTR_LABEL, nextUp, type Attr } from '../../game/engine'
+import { useGame } from '../../game/GameProvider'
+import { shortDate } from '../../lib/date'
+import { useStore } from '../../state/store'
+import { useVibe } from '../../themes/vibe'
+import { Button } from '../ui/Button'
+import { Panel } from '../ui/Panel'
+import { AchievementsDialog } from './AchievementsDialog'
+import { Badge, RARITY_COLOR } from './Badge'
+
+/** A class sigil: a ring per ten levels around a glyph. */
+function Sigil({ level }: { level: number }) {
+  const rings = Math.min(4, 1 + Math.floor(level / 10))
+  return (
+    <svg viewBox="0 0 64 64" className="size-16 shrink-0 text-ink" aria-hidden="true">
+      {Array.from({ length: rings }, (_, i) => (
+        <circle key={i} cx="32" cy="32" r={29 - i * 5} fill="none" stroke="currentColor" strokeWidth={i === 0 ? 2 : 1} opacity={1 - i * 0.2} strokeDasharray={i % 2 ? '2 3' : undefined} />
+      ))}
+      <text x="32" y="38" textAnchor="middle" className="font-display" fontSize="18" fontWeight="600" fill="currentColor">
+        {level}
+      </text>
+    </svg>
+  )
+}
+
+export function HeroPanel() {
+  const { game } = useGame()
+  const { user } = useStore()
+  const vibe = useVibe()
+  const [open, setOpen] = useState(false)
+  const pct = (game.level.into / game.level.span) * 100
+  const maxAttr = Math.max(1, ...Object.values(game.attrs))
+  const recent = game.achievements
+    .filter((v) => v.unlocked)
+    .sort((a, b) => (b.unlockedOn ?? '9').localeCompare(a.unlockedOn ?? '9') || b.a.xp - a.a.xp)
+    .slice(0, 6)
+  const upcoming = nextUp(game, 3)
+
+  return (
+    <Panel id="hero" title={vibe.heroTab} hint={`${game.unlockedCount} of 300 achievements`}>
+      <div className="flex items-center gap-4">
+        <Sigil level={game.level.level} />
+        <div className="min-w-0 flex-1">
+          <p className="truncate font-display text-lg font-medium tracking-[-0.01em] text-ink">{user.name ?? 'Adventurer'}</p>
+          <p className="text-[13px] text-ink-2">
+            {vibe.level} {game.level.level} {game.cls}, {game.title}
+          </p>
+          <div className="mt-2 h-2 overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-valuemin={0} aria-valuemax={game.level.span} aria-valuenow={game.level.into} aria-label="Progress to next level">
+            <div className="h-full rounded-full bg-accent-sand transition-[width] duration-700" style={{ width: `${pct}%` }} />
+          </div>
+          <p className="mt-1 text-[12px] text-muted tabular">
+            {game.level.into.toLocaleString()} / {game.level.span.toLocaleString()} {vibe.xp}, {game.level.toNext.toLocaleString()} to go
+          </p>
+        </div>
+      </div>
+
+      <dl className="mt-5 space-y-1.5">
+        {(Object.keys(game.attrs) as Attr[]).map((k) => (
+          <div key={k} className="flex items-center gap-3 text-[12px]" title={ATTR_LABEL[k]}>
+            <dt className="w-8 font-semibold text-ink-2 tabular">{k}</dt>
+            <dd className="h-1.5 flex-1 overflow-hidden rounded-full bg-surface-2">
+              <div className="h-full rounded-full bg-ink-2" style={{ width: `${(game.attrs[k] / maxAttr) * 100}%` }} />
+            </dd>
+            <dd className="w-12 text-right text-muted tabular">{Math.round(game.attrs[k])}</dd>
+          </div>
+        ))}
+      </dl>
+
+      {upcoming.length > 0 && (
+        <div className="mt-5 border-t border-line pt-4">
+          <h3 className="mb-2 text-[13px] text-ink-2">Next up</h3>
+          <ul className="space-y-2.5">
+            {upcoming.map((v) => (
+              <li key={v.a.id} className="flex items-center gap-3">
+                <Badge rarity={v.a.rarity} category={v.a.category} size={30} locked />
+                <div className="min-w-0 flex-1">
+                  <p className="truncate text-sm text-ink">{v.a.name}</p>
+                  <p className="truncate text-[12px] text-muted">{v.a.description}</p>
+                  <div className="mt-1 h-1 overflow-hidden rounded-full bg-surface-2">
+                    <div className="h-full rounded-full" style={{ width: `${v.progress * 100}%`, background: RARITY_COLOR[v.a.rarity] }} />
+                  </div>
+                </div>
+                <span className="text-[12px] text-muted tabular">+{v.a.xp}</span>
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      {recent.length > 0 && (
+        <div className="mt-5 border-t border-line pt-4">
+          <h3 className="mb-2 text-[13px] text-ink-2">Recently earned</h3>
+          <ul className="grid grid-cols-6 gap-1.5">
+            {recent.map((v) => (
+              <li key={v.a.id} title={`${v.a.name}${v.unlockedOn ? `, ${shortDate(v.unlockedOn)}` : ''}`}>
+                <Badge rarity={v.a.rarity} category={v.a.category} size={40} />
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      <Button className="mt-5 w-full" onClick={() => setOpen(true)}>
+        All achievements ({game.unlockedCount}/300)
+      </Button>
+      {open && <AchievementsDialog onClose={() => setOpen(false)} />}
+    </Panel>
+  )
+}
