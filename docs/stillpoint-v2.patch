diff --git a/supabase/migrations/20261031120000_stillpoint_v2.sql b/supabase/migrations/20261031120000_stillpoint_v2.sql
new file mode 100644
index 0000000..a7f05ce
--- /dev/null
+++ b/supabase/migrations/20261031120000_stillpoint_v2.sql
@@ -0,0 +1,237 @@
+-- ════════════════════════════════════════════════════════════════════════
+-- Stillpoint v2: per-user data with row-level security and realtime sync.
+--
+-- Isolation model
+--   * Every user-owned table has `user_id uuid not null default auth.uid()`.
+--   * RLS is enabled and FORCED on every table; the only policies grant the
+--     `authenticated` role access to rows where user_id = auth.uid().
+--   * `anon` has no privileges at all. Unauthenticated requests see nothing.
+--   * Child rows (habit_completions) reference their parent through a
+--     composite (id, user_id) foreign key, so a row can never point at
+--     another user's habit even if a client forges the habit_id.
+-- ════════════════════════════════════════════════════════════════════════
+
+create extension if not exists pgcrypto;
+
+-- ── Helpers ─────────────────────────────────────────────────────────────
+
+create or replace function public.set_updated_at()
+returns trigger
+language plpgsql
+as $$
+begin
+  new.updated_at := now();
+  return new;
+end;
+$$;
+
+-- ── users ───────────────────────────────────────────────────────────────
+-- Public profile mirrored from auth.users (Google name + avatar).
+
+create table public.users (
+  id                uuid primary key references auth.users (id) on delete cascade,
+  email             text not null,
+  name              text,
+  image             text,
+  defaults_seeded   boolean not null default false,
+  created_at        timestamptz not null default now(),
+  updated_at        timestamptz not null default now()
+);
+
+create or replace function public.handle_new_auth_user()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  insert into public.users (id, email, name, image)
+  values (
+    new.id,
+    coalesce(new.email, ''),
+    coalesce(new.raw_user_meta_data ->> 'full_name', new.raw_user_meta_data ->> 'name'),
+    coalesce(new.raw_user_meta_data ->> 'avatar_url', new.raw_user_meta_data ->> 'picture')
+  )
+  on conflict (id) do update
+    set email = excluded.email,
+        name  = coalesce(excluded.name, public.users.name),
+        image = coalesce(excluded.image, public.users.image);
+  return new;
+end;
+$$;
+
+create trigger on_auth_user_created
+  after insert or update of email, raw_user_meta_data on auth.users
+  for each row execute function public.handle_new_auth_user();
+
+-- ── habits ──────────────────────────────────────────────────────────────
+
+create table public.habits (
+  id          uuid primary key default gen_random_uuid(),
+  user_id     uuid not null default auth.uid() references public.users (id) on delete cascade,
+  name        text not null check (char_length(btrim(name)) between 1 and 60),
+  accent      text not null default 'sage'
+              check (accent in ('sage', 'dusk', 'mauve', 'sand', 'teal', 'clay')),
+  created_on  date not null,
+  archived_on date,
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now(),
+  constraint habits_id_user_unique unique (id, user_id),
+  constraint habits_archive_after_create check (archived_on is null or archived_on >= created_on)
+);
+create index habits_user_idx on public.habits (user_id);
+
+create table public.habit_completions (
+  id         uuid primary key default gen_random_uuid(),
+  user_id    uuid not null default auth.uid() references public.users (id) on delete cascade,
+  habit_id   uuid not null,
+  date       date not null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  constraint habit_completions_once_per_day unique (habit_id, date),
+  constraint habit_completions_same_owner
+    foreign key (habit_id, user_id) references public.habits (id, user_id) on delete cascade
+);
+create index habit_completions_user_date_idx on public.habit_completions (user_id, date);
+
+create table public.milestones (
+  id            uuid primary key default gen_random_uuid(),
+  user_id       uuid not null default auth.uid() references public.users (id) on delete cascade,
+  milestone_key text not null check (milestone_key ~ '^[a-z0-9-]{1,40}$'),
+  reached_on    date not null,
+  created_at    timestamptz not null default now(),
+  updated_at    timestamptz not null default now(),
+  constraint milestones_once unique (user_id, milestone_key)
+);
+
+-- ── daily_observations ──────────────────────────────────────────────────
+
+create table public.daily_observations (
+  id                      uuid primary key default gen_random_uuid(),
+  user_id                 uuid not null default auth.uid() references public.users (id) on delete cascade,
+  date                    date not null,
+  critical_thinking_text  text not null default '' check (char_length(critical_thinking_text) <= 20000),
+  observations_text       text not null default '' check (char_length(observations_text) <= 20000),
+  created_at              timestamptz not null default now(),
+  updated_at              timestamptz not null default now(),
+  constraint daily_observations_one_per_day unique (user_id, date)
+);
+
+-- ── meals ───────────────────────────────────────────────────────────────
+
+create table public.meals (
+  id           uuid primary key default gen_random_uuid(),
+  user_id      uuid not null default auth.uid() references public.users (id) on delete cascade,
+  date         date not null,
+  meal_number  smallint not null check (meal_number between 1 and 5),
+  is_completed boolean not null default false,
+  notes        text not null default '' check (char_length(notes) <= 120),
+  created_at   timestamptz not null default now(),
+  updated_at   timestamptz not null default now(),
+  constraint meals_one_per_slot unique (user_id, date, meal_number)
+);
+
+-- ── workouts ────────────────────────────────────────────────────────────
+-- One row per user per ISO week (weeks start on Monday).
+
+create table public.workouts (
+  id              uuid primary key default gen_random_uuid(),
+  user_id         uuid not null default auth.uid() references public.users (id) on delete cascade,
+  week_start_date date not null check (extract(isodow from week_start_date) = 1),
+  workout_count   smallint not null default 0 check (workout_count between 0 and 4),
+  created_at      timestamptz not null default now(),
+  updated_at      timestamptz not null default now(),
+  constraint workouts_one_per_week unique (user_id, week_start_date)
+);
+
+-- ── non_essential_spendings ─────────────────────────────────────────────
+
+create table public.non_essential_spendings (
+  id          uuid primary key default gen_random_uuid(),
+  user_id     uuid not null default auth.uid() references public.users (id) on delete cascade,
+  date        date not null,
+  amount      numeric(12, 2) not null check (amount > 0 and amount < 1000000),
+  description text not null check (char_length(btrim(description)) between 1 and 80),
+  category    text not null default 'other'
+              check (category in ('coffee', 'subscription', 'impulse', 'eating-out', 'entertainment', 'other')),
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now()
+);
+create index non_essential_spendings_user_date_idx on public.non_essential_spendings (user_id, date);
+
+-- ── updated_at triggers ─────────────────────────────────────────────────
+
+do $$
+declare t text;
+begin
+  foreach t in array array[
+    'users', 'habits', 'habit_completions', 'milestones',
+    'daily_observations', 'meals', 'workouts', 'non_essential_spendings'
+  ] loop
+    execute format(
+      'create trigger %I before update on public.%I for each row execute function public.set_updated_at()',
+      t || '_set_updated_at', t
+    );
+  end loop;
+end $$;
+
+-- ── Row-level security ──────────────────────────────────────────────────
+
+-- users: RLS enabled but not FORCED, so the security-definer trigger above
+-- (owned by the table owner) can create profiles. Clients are unaffected:
+-- they connect as `authenticated`, which the policies below still bind.
+alter table public.users enable row level security;
+
+create policy "users: read own profile" on public.users
+  for select to authenticated using (id = (select auth.uid()));
+create policy "users: update own profile" on public.users
+  for update to authenticated using (id = (select auth.uid())) with check (id = (select auth.uid()));
+
+do $$
+declare t text;
+begin
+  foreach t in array array[
+    'habits', 'habit_completions', 'milestones',
+    'daily_observations', 'meals', 'workouts', 'non_essential_spendings'
+  ] loop
+    execute format('alter table public.%I enable row level security', t);
+    execute format('alter table public.%I force row level security', t);
+    execute format(
+      'create policy %I on public.%I for all to authenticated
+         using (user_id = (select auth.uid()))
+         with check (user_id = (select auth.uid()))',
+      t || ': owner only', t
+    );
+  end loop;
+end $$;
+
+-- ── Privileges ──────────────────────────────────────────────────────────
+
+revoke all on all tables in schema public from anon;
+revoke all on all tables in schema public from authenticated;
+
+grant select, update (name, image, defaults_seeded) on public.users to authenticated;
+grant select, insert, update, delete on
+  public.habits, public.habit_completions, public.milestones,
+  public.daily_observations, public.meals, public.workouts, public.non_essential_spendings
+  to authenticated;
+
+-- ── Realtime ────────────────────────────────────────────────────────────
+-- Realtime evaluates the same RLS policies before delivering INSERT/UPDATE
+-- events, so each client only receives its own rows.
+
+alter publication supabase_realtime add table
+  public.habits, public.habit_completions, public.milestones,
+  public.daily_observations, public.meals, public.workouts, public.non_essential_spendings;
+
+-- ── Backfill ────────────────────────────────────────────────────────────
+-- Accounts that signed in before this migration ran have no profile yet.
+
+insert into public.users (id, email, name, image)
+select
+  u.id,
+  coalesce(u.email, ''),
+  coalesce(u.raw_user_meta_data ->> 'full_name', u.raw_user_meta_data ->> 'name'),
+  coalesce(u.raw_user_meta_data ->> 'avatar_url', u.raw_user_meta_data ->> 'picture')
+from auth.users u
+on conflict (id) do nothing;
diff --git a/supabase/tests/rls.test.sql b/supabase/tests/rls.test.sql
new file mode 100644
index 0000000..20a63e3
--- /dev/null
+++ b/supabase/tests/rls.test.sql
@@ -0,0 +1,129 @@
+-- Isolation tests. Run after supabase_shim.sql + the migration.
+-- Every block raises an exception on failure; success prints PASS lines.
+\set ON_ERROR_STOP on
+\set alice '''11111111-1111-1111-1111-111111111111'''
+\set bob   '''22222222-2222-2222-2222-222222222222'''
+
+select 'PASS pre-existing account backfilled by migration'
+  where exists (select 1 from public.users where email = 'early@example.com');
+
+insert into auth.users (id, email, raw_user_meta_data) values
+  (:alice, 'alice@example.com', '{"full_name":"Alice A","avatar_url":"https://x/a.png"}'),
+  (:bob,   'bob@example.com',   '{"name":"Bob B","picture":"https://x/b.png"}');
+
+select 'PASS profile trigger (runs as non-superuser owner)' where (select count(*) from public.users where id in (:alice, :bob)) = 2
+  and (select name from public.users where id = :alice) = 'Alice A'
+  and (select image from public.users where id = :bob) = 'https://x/b.png';
+
+-- Act as Alice.
+set role authenticated;
+select set_config('request.jwt.claim.sub', :alice, false);
+
+insert into public.habits (id, name, accent, created_on) values
+  ('aaaaaaaa-0000-0000-0000-000000000001', 'Gym', 'clay', '2026-10-01');
+insert into public.habit_completions (habit_id, date) values ('aaaaaaaa-0000-0000-0000-000000000001', '2026-10-30');
+insert into public.daily_observations (date, critical_thinking_text) values ('2026-10-31', 'Alice private note');
+insert into public.meals (date, meal_number, is_completed, notes) values ('2026-10-31', 1, true, 'Oats');
+insert into public.workouts (week_start_date, workout_count) values ('2026-10-26', 2);
+insert into public.non_essential_spendings (date, amount, description, category) values ('2026-10-31', 4.50, 'Flat white', 'coffee');
+insert into public.milestones (milestone_key, reached_on) values ('streak-3', '2026-10-31');
+select 'PASS alice writes own rows (user_id defaulted from auth.uid())'
+  where (select count(*) from public.habits where user_id = :alice) = 1;
+
+-- Act as Bob.
+select set_config('request.jwt.claim.sub', :bob, false);
+do $$
+declare n int;
+begin
+  select (select count(*) from public.habits) + (select count(*) from public.habit_completions)
+       + (select count(*) from public.daily_observations) + (select count(*) from public.meals)
+       + (select count(*) from public.workouts) + (select count(*) from public.non_essential_spendings)
+       + (select count(*) from public.milestones) into n;
+  if n <> 0 then raise exception 'FAIL bob can see % of alice''s rows', n; end if;
+  if (select count(*) from public.users) <> 1 then raise exception 'FAIL bob sees other profiles'; end if;
+  raise notice 'PASS bob sees none of alice''s rows and only his own profile';
+end $$;
+
+do $$
+begin
+  update public.non_essential_spendings set amount = 999;
+  delete from public.daily_observations;
+  if found then raise exception 'FAIL bob deleted alice data'; end if;
+  raise notice 'PASS bob update/delete affect 0 alice rows';
+end $$;
+
+do $$ begin
+  insert into public.habits (name, created_on, user_id) values ('Spoof', '2026-10-01', '11111111-1111-1111-1111-111111111111');
+  raise exception 'FAIL bob inserted a row owned by alice';
+exception when insufficient_privilege then raise notice 'PASS insert with forged user_id rejected by RLS';
+end $$;
+
+do $$ begin
+  insert into public.habits (id, name, created_on) values ('bbbbbbbb-0000-0000-0000-000000000001', 'Read', '2026-10-01');
+  insert into public.habit_completions (habit_id, date) values ('aaaaaaaa-0000-0000-0000-000000000001', '2026-10-31');
+  raise exception 'FAIL bob completed alice''s habit';
+exception when foreign_key_violation then raise notice 'PASS completion pointing at another user''s habit rejected (composite FK)';
+end $$;
+
+do $$ begin
+  update public.users set email = 'evil@example.com';
+  raise exception 'FAIL email column writable';
+exception when insufficient_privilege then raise notice 'PASS profile email is read-only to clients';
+end $$;
+
+-- Constraints
+do $$ begin
+  insert into public.meals (date, meal_number) values ('2026-10-31', 6);
+  raise exception 'FAIL meal 6 allowed';
+exception when check_violation then raise notice 'PASS meal_number limited to 1..5';
+end $$;
+do $$ begin
+  insert into public.workouts (week_start_date, workout_count) values ('2026-10-26', 5);
+  raise exception 'FAIL 5 workouts allowed';
+exception when check_violation then raise notice 'PASS workout_count limited to 0..4';
+end $$;
+do $$ begin
+  insert into public.workouts (week_start_date) values ('2026-10-28');
+  raise exception 'FAIL non-Monday week start allowed';
+exception when check_violation then raise notice 'PASS week_start_date must be a Monday';
+end $$;
+do $$ begin
+  insert into public.non_essential_spendings (date, amount, description) values ('2026-10-31', 0, 'Free');
+  raise exception 'FAIL zero amount allowed';
+exception when check_violation then raise notice 'PASS spending amount must be positive';
+end $$;
+
+-- Upserts on the natural keys used by the client
+insert into public.meals (date, meal_number, is_completed) values ('2026-10-31', 2, true)
+  on conflict (user_id, date, meal_number) do update set is_completed = excluded.is_completed;
+insert into public.meals (date, meal_number, notes) values ('2026-10-31', 2, 'Shake')
+  on conflict (user_id, date, meal_number) do update set notes = excluded.notes;
+select 'PASS meal upsert merges on (user_id, date, meal_number)'
+  where (select count(*) from public.meals) = 1 and (select notes from public.meals) = 'Shake';
+insert into public.workouts (week_start_date, workout_count) values ('2026-10-26', 1)
+  on conflict (user_id, week_start_date) do update set workout_count = excluded.workout_count;
+insert into public.workouts (week_start_date, workout_count) values ('2026-10-26', 3)
+  on conflict (user_id, week_start_date) do update set workout_count = excluded.workout_count;
+select 'PASS workouts upsert per week' where (select workout_count from public.workouts) = 3;
+
+-- Anonymous visitors
+reset role;
+set role anon;
+select set_config('request.jwt.claim.sub', '', false);
+do $$ begin
+  perform 1 from public.habits;
+  raise exception 'FAIL anon can read habits';
+exception when insufficient_privilege then raise notice 'PASS anon has no access';
+end $$;
+reset role;
+
+-- Alice's data untouched by Bob's attempts
+select 'PASS alice data intact' where
+  (select amount from public.non_essential_spendings where user_id = :alice) = 4.50
+  and (select count(*) from public.daily_observations where user_id = :alice) = 1;
+
+-- Cascade on account deletion
+delete from auth.users where id = :alice;
+select 'PASS deleting an account removes all its rows' where
+  (select count(*) from public.habits where user_id = :alice) = 0
+  and (select count(*) from public.non_essential_spendings where user_id = :alice) = 0;
diff --git a/supabase/tests/run.sh b/supabase/tests/run.sh
new file mode 100755
index 0000000..1bc3f30
--- /dev/null
+++ b/supabase/tests/run.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# Applies the migration to a throwaway database and runs the isolation tests.
+# The migration runs as a non-superuser role (like Supabase's `postgres`), so
+# RLS applies to it the way it does in production.
+# Usage: PGURI=postgres://user@localhost/postgres ./supabase/tests/run.sh
+set -euo pipefail
+cd "$(dirname "$0")"
+DB="stillpoint_test_$$"
+psql "$PGURI" -qc "create database $DB" >/dev/null
+trap 'psql "$PGURI" -qc "drop database if exists $DB" >/dev/null' EXIT
+URI="${PGURI%/*}/$DB"
+psql "$URI" -q -v ON_ERROR_STOP=1 -f supabase_shim.sql 2>/dev/null
+psql "$URI" -q -v ON_ERROR_STOP=1 -c "do \$\$ begin if not exists (select 1 from pg_roles where rolname='app_owner') then create role app_owner nologin; end if; end \$\$;
+  grant create, usage on schema public to app_owner; grant usage on schema auth to app_owner;
+  grant select, insert, update, delete, references, trigger on auth.users to app_owner;
+  alter publication supabase_realtime owner to app_owner;" >/dev/null
+( echo "set role app_owner;"; cat ../migrations/*.sql ) | psql "$URI" -q -v ON_ERROR_STOP=1 2>&1 | grep -v "wal_level\|HINT" || true
+psql "$URI" -q -v ON_ERROR_STOP=1 -t -f rls.test.sql 2>&1 | sed -E -e 's/^psql:[^ ]+ NOTICE:  //' -e 's/^NOTICE:  //' -e '/^ *[0-9a-f-]{36}$/d' -e '/^\s*$/d' -e 's/^ *//'
diff --git a/supabase/tests/supabase_shim.sql b/supabase/tests/supabase_shim.sql
new file mode 100644
index 0000000..32b0927
--- /dev/null
+++ b/supabase/tests/supabase_shim.sql
@@ -0,0 +1,29 @@
+-- Minimal stand-in for the parts of Supabase the migration relies on,
+create extension if not exists pgcrypto;
+-- so it can be tested on plain Postgres (CI or local) without the full stack.
+do $$ begin
+  if not exists (select 1 from pg_roles where rolname = 'anon') then create role anon nologin; end if;
+  if not exists (select 1 from pg_roles where rolname = 'authenticated') then create role authenticated nologin; end if;
+end $$;
+create schema if not exists auth;
+create table if not exists auth.users (
+  id uuid primary key,
+  email text,
+  raw_user_meta_data jsonb default '{}'::jsonb
+);
+create or replace function auth.uid() returns uuid language sql stable as $$
+  select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid
+$$;
+grant usage on schema auth to anon, authenticated;
+grant execute on function auth.uid() to anon, authenticated;
+grant usage on schema public to anon, authenticated;
+do $$ begin
+  if not exists (select 1 from pg_publication where pubname = 'supabase_realtime') then
+    create publication supabase_realtime;
+  end if;
+end $$;
+
+-- An account that signed in before the migration ran (tests the backfill).
+insert into auth.users (id, email, raw_user_meta_data)
+values ('33333333-3333-3333-3333-333333333333', 'early@example.com', '{}')
+on conflict do nothing;
