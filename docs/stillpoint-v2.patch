--- /dev/null
+++ b/src/data/backend.ts
@@ -0,0 +1,63 @@
+import type { Op, RemoteEvent } from './ops'
+import type { Snapshot } from './schema'
+
+export interface AuthUser {
+  id: string
+  email: string
+  name: string | null
+  image: string | null
+}
+
+export interface Profile {
+  defaultsSeeded: boolean
+}
+
+export type WriteResult = { ok: true } | { ok: false; retry: boolean; message: string }
+
+export type ChannelStatus = 'live' | 'down'
+
+/**
+ * Everything the app needs from a server. Implemented by Supabase in
+ * production and by an in-browser fake for end-to-end tests.
+ * Every method that touches data takes the signed-in user's id and must
+ * scope to it; the database enforces the same rule independently via RLS.
+ */
+export interface Backend {
+  readonly kind: 'supabase' | 'memory'
+  getUser(): Promise<AuthUser | null>
+  onAuthChange(cb: (user: AuthUser | null) => void): () => void
+  signInWithGoogle(): Promise<void>
+  signOut(): Promise<void>
+
+  fetchSnapshot(userId: string, today: string): Promise<{ snapshot: Snapshot; profile: Profile }>
+  write(op: Op, userId: string): Promise<WriteResult>
+  markDefaultsSeeded(userId: string): Promise<void>
+  subscribe(userId: string, onEvent: (ev: RemoteEvent) => void, onStatus: (s: ChannelStatus) => void): () => void
+}
+
+export class ConfigError extends Error {}
+
+let backendPromise: Promise<Backend> | null = null
+
+/**
+ * One backend (and so one Supabase client) per page. Two clients would both
+ * try to finish the OAuth redirect and contend for the same session lock;
+ * React's development double-mount would otherwise create exactly that.
+ */
+export function createBackend(): Promise<Backend> {
+  backendPromise ??= (async () => {
+    // Statically replaced at build time, so the fake backend is tree-shaken out
+    // of every build that doesn't set this flag.
+    if (import.meta.env.VITE_E2E_MEMORY_BACKEND === 'true') {
+      const { createMemoryBackend } = await import('./memoryBackend')
+      return createMemoryBackend()
+    }
+    const { createSupabaseBackend } = await import('./supabaseBackend')
+    return createSupabaseBackend()
+  })()
+  // A config error should be shown again on retry, not cached forever.
+  backendPromise.catch(() => {
+    backendPromise = null
+  })
+  return backendPromise
+}
diff --git a/src/data/legacyImport.ts b/src/data/legacyImport.ts
new file mode 100644
index 0000000..0345805
--- /dev/null
+++ b/src/data/legacyImport.ts
@@ -0,0 +1,58 @@
+import { uid } from '../lib/id'
+import type { LegacyState } from '../state/storage'
+import { ACCENTS } from '../lib/accents'
+import type { Op } from './ops'
+import { rowKey, type TableStore } from './schema'
+
+/**
+ * Turns v1 local-only data into ops for the signed-in account.
+ * Habits are matched by name (case-insensitive) so history lands on the
+ * existing habit rather than creating a duplicate. Completions that already
+ * exist are skipped, so importing twice is harmless.
+ */
+export function legacyImportOps(legacy: LegacyState, t: TableStore, userId: string): Op[] {
+  const ops: Op[] = []
+  const byName = new Map(Object.values(t.habits).map((h) => [h.name.trim().toLowerCase(), h]))
+  const idMap = new Map<string, string>()
+  const validAccent = (a: string) => (ACCENTS.some((x) => x.id === a) ? a : 'sage')
+
+  for (const h of legacy.habits) {
+    const existing = byName.get(h.name.trim().toLowerCase())
+    if (existing) {
+      idMap.set(h.id, existing.id)
+      if (h.createdOn < existing.created_on) {
+        ops.push({ opId: uid(), table: 'habits', kind: 'update', key: existing.id, id: existing.id, patch: { created_on: h.createdOn } })
+      }
+      continue
+    }
+    const id = uid()
+    idMap.set(h.id, id)
+    const row = {
+      id,
+      user_id: userId,
+      name: h.name.trim().slice(0, 60),
+      accent: validAccent(h.accent),
+      created_on: h.createdOn,
+      archived_on: h.archivedOn && h.archivedOn >= h.createdOn ? h.archivedOn : null,
+    }
+    ops.push({ opId: uid(), table: 'habits', kind: 'upsert', key: id, row })
+  }
+
+  const have = new Set(Object.values(t.habit_completions).map((c) => `${c.habit_id}|${c.date}`))
+  for (const [date, ids] of Object.entries(legacy.completions)) {
+    for (const oldId of ids) {
+      const habitId = idMap.get(oldId)
+      if (!habitId || have.has(`${habitId}|${date}`)) continue
+      have.add(`${habitId}|${date}`)
+      const row = { id: uid(), user_id: userId, habit_id: habitId, date }
+      ops.push({ opId: uid(), table: 'habit_completions', kind: 'upsert', key: row.id, row })
+    }
+  }
+
+  for (const [key, reached] of Object.entries(legacy.milestones ?? {})) {
+    if (t.milestones[key]) continue
+    const row = { user_id: userId, milestone_key: key, reached_on: reached }
+    ops.push({ opId: uid(), table: 'milestones', kind: 'upsert', key: rowKey('milestones', row), row })
+  }
+  return ops
+}
diff --git a/src/data/memoryBackend.ts b/src/data/memoryBackend.ts
new file mode 100644
index 0000000..deb47b1
--- /dev/null
+++ b/src/data/memoryBackend.ts
@@ -0,0 +1,115 @@
+/**
+ * In-browser stand-in for Supabase, used only by end-to-end tests
+ * (VITE_E2E_MEMORY_BACKEND=true). Tabs of the same browser share one
+ * "database" in localStorage and receive each other's changes over a
+ * BroadcastChannel, which mimics two devices on Supabase Realtime.
+ * Setting localStorage['e2e:offline'] = '1' simulates losing the network.
+ * Never included in production builds.
+ */
+import type { AuthUser, Backend, WriteResult } from './backend'
+import type { RemoteEvent } from './ops'
+import { rowKey, TABLE_NAMES, usesNaturalKey, type AnyRow, type Snapshot, type TableName } from './schema'
+
+const DB_KEY = 'e2e:db'
+const SESSION_KEY = 'e2e:session'
+const TEST_USER: AuthUser = { id: '00000000-0000-4000-8000-0000000000e2', email: 'sam@example.com', name: 'Sam Rivera', image: null }
+
+type Db = { tables: Record<TableName, AnyRow[]>; profile: { defaultsSeeded: boolean } }
+
+const load = (): Db => {
+  try {
+    const db = JSON.parse(localStorage.getItem(DB_KEY) ?? 'null')
+    if (db) return db
+  } catch {
+    /* fall through */
+  }
+  return { tables: Object.fromEntries(TABLE_NAMES.map((t) => [t, []])) as unknown as Db['tables'], profile: { defaultsSeeded: false } }
+}
+const save = (db: Db) => localStorage.setItem(DB_KEY, JSON.stringify(db))
+const offline = () => localStorage.getItem('e2e:offline') === '1'
+const delay = () => new Promise((r) => setTimeout(r, 40))
+
+export function createMemoryBackend(): Backend {
+  const bus = new BroadcastChannel('e2e:realtime')
+  const authListeners = new Set<(u: AuthUser | null) => void>()
+  const session = () => (localStorage.getItem(SESSION_KEY) ? TEST_USER : null)
+
+  return {
+    kind: 'memory',
+    async getUser() {
+      return session()
+    },
+    onAuthChange(cb) {
+      authListeners.add(cb)
+      return () => authListeners.delete(cb)
+    },
+    async signInWithGoogle() {
+      localStorage.setItem(SESSION_KEY, '1')
+      authListeners.forEach((l) => l(TEST_USER))
+    },
+    async signOut() {
+      localStorage.removeItem(SESSION_KEY)
+      authListeners.forEach((l) => l(null))
+    },
+
+    async fetchSnapshot(userId) {
+      await delay()
+      if (offline()) throw new Error('Failed to fetch')
+      const db = load()
+      const snapshot = Object.fromEntries(
+        TABLE_NAMES.map((t) => [t, db.tables[t].filter((r) => r.user_id === userId)]),
+      ) as unknown as Snapshot
+      return { snapshot, profile: db.profile }
+    },
+
+    async write(op, userId): Promise<WriteResult> {
+      await delay()
+      if (offline()) return { ok: false, retry: true, message: 'Failed to fetch' }
+      const db = load()
+      const rows = db.tables[op.table]
+      const find = (pred: (r: AnyRow) => boolean) => rows.findIndex((r) => r.user_id === userId && pred(r))
+      let event: RemoteEvent
+
+      if (op.kind === 'upsert') {
+        const row: AnyRow = { ...op.row, user_id: userId }
+        const key = rowKey(op.table, row)
+        const i = find((r) => rowKey(op.table, r) === key)
+        if (op.table === 'habit_completions' && i < 0 && find((r) => r.habit_id === row.habit_id && r.date === row.date) >= 0) {
+          return { ok: false, retry: false, message: 'duplicate key value violates unique constraint "habit_completions_once_per_day"' }
+        }
+        if (i >= 0) rows[i] = { ...rows[i], ...row }
+        else rows.push(usesNaturalKey(op.table) ? { id: crypto.randomUUID(), ...row } : row)
+        event = { table: op.table, type: 'upsert', row: rows[i >= 0 ? i : rows.length - 1] }
+      } else if (op.kind === 'update') {
+        const i = find((r) => r.id === op.id)
+        if (i < 0) return { ok: true }
+        rows[i] = { ...rows[i], ...op.patch }
+        event = { table: op.table, type: 'upsert', row: rows[i] }
+      } else {
+        const i = find((r) => r.id === op.id)
+        if (i < 0) return { ok: true }
+        rows.splice(i, 1)
+        if (op.table === 'habits') {
+          db.tables.habit_completions = db.tables.habit_completions.filter((c) => c.habit_id !== op.id)
+        }
+        event = { table: op.table, type: 'delete', id: op.id }
+      }
+      save(db)
+      bus.postMessage(event)
+      return { ok: true }
+    },
+
+    async markDefaultsSeeded() {
+      const db = load()
+      db.profile.defaultsSeeded = true
+      save(db)
+    },
+
+    subscribe(_userId, onEvent, onStatus) {
+      const handler = (e: MessageEvent<RemoteEvent>) => onEvent(e.data)
+      bus.addEventListener('message', handler)
+      setTimeout(() => onStatus('live'), 0)
+      return () => bus.removeEventListener('message', handler)
+    },
+  }
+}
diff --git a/src/data/ops.ts b/src/data/ops.ts
new file mode 100644
index 0000000..ea153c8
--- /dev/null
+++ b/src/data/ops.ts
@@ -0,0 +1,87 @@
+import { rowKey, TABLE_NAMES, type AnyRow, type Snapshot, type TableName, type TableStore } from './schema'
+
+/**
+ * A pending change. Ops are applied to local state immediately and queued in
+ * the outbox until the server accepts them. All three kinds are idempotent,
+ * so replaying an op after a dropped connection is always safe.
+ *
+ * - upsert: insert-or-merge. Natural-key tables send only the columns that
+ *   changed (PostgREST updates just those), so concurrent edits to different
+ *   fields of one row on two devices don't clobber each other.
+ * - update: patch an existing row by id.
+ * - delete: remove a row by id.
+ */
+export type Op =
+  | { opId: string; table: TableName; kind: 'upsert'; key: string; row: AnyRow }
+  | { opId: string; table: TableName; kind: 'update'; key: string; id: string; patch: AnyRow }
+  | { opId: string; table: TableName; kind: 'delete'; key: string; id: string }
+
+export type RemoteEvent = { table: TableName; type: 'upsert'; row: AnyRow } | { table: TableName; type: 'delete'; id: string }
+
+export const opSlot = (op: Pick<Op, 'table' | 'key'>) => `${op.table}:${op.key}`
+
+type Mutable = Record<string, AnyRow>
+
+/** Returns a new store with the op applied. Unchanged tables keep identity. */
+export function applyOp(store: TableStore, op: Op): TableStore {
+  const table = { ...(store[op.table] as Mutable) }
+  const next = { ...store, [op.table]: table } as TableStore
+
+  if (op.kind === 'upsert') {
+    table[op.key] = { ...table[op.key], ...op.row }
+  } else if (op.kind === 'update') {
+    if (table[op.key]) table[op.key] = { ...table[op.key], ...op.patch }
+  } else {
+    delete table[op.key]
+    // Mirror the database's ON DELETE CASCADE locally.
+    if (op.table === 'habits') {
+      const completions = { ...(store.habit_completions as Mutable) }
+      for (const [k, c] of Object.entries(completions)) if (c.habit_id === op.id) delete completions[k]
+      next.habit_completions = completions as TableStore['habit_completions']
+    }
+  }
+  return next
+}
+
+/** Applies a change pushed from the server (another device, or our own echo). */
+export function applyRemote(store: TableStore, ev: RemoteEvent): TableStore {
+  if (ev.type === 'upsert') {
+    const key = rowKey(ev.table, ev.row)
+    const table = { ...(store[ev.table] as Mutable), [key]: { ...(store[ev.table] as Mutable)[key], ...ev.row } }
+    return { ...store, [ev.table]: table } as TableStore
+  }
+  // Delete events carry only the primary key, so find the row by id.
+  const rows = store[ev.table] as Mutable
+  const key = Object.keys(rows).find((k) => rows[k].id === ev.id)
+  return key ? applyOp(store, { opId: '', table: ev.table, kind: 'delete', key, id: ev.id }) : store
+}
+
+export function storeFromSnapshot(snap: Partial<Snapshot>): TableStore {
+  const out = {} as Record<TableName, Mutable>
+  for (const t of TABLE_NAMES) {
+    out[t] = {}
+    for (const row of (snap[t] ?? []) as AnyRow[]) out[t][rowKey(t, row)] = row
+  }
+  return out as TableStore
+}
+
+/**
+ * Adds an op to the queue, folding it into the last queued op for the same row
+ * when possible (e.g. each keystroke of an autosaving note).
+ * `lockedOpId` is the op currently being sent; it is never modified.
+ */
+export function enqueue(outbox: Op[], op: Op, lockedOpId?: string): Op[] {
+  const last = outbox[outbox.length - 1]
+  if (last && last.opId !== lockedOpId && opSlot(last) === opSlot(op)) {
+    if (last.kind === 'upsert' && op.kind === 'upsert') {
+      return [...outbox.slice(0, -1), { ...last, row: { ...last.row, ...op.row } }]
+    }
+    if (last.kind === 'update' && op.kind === 'update') {
+      return [...outbox.slice(0, -1), { ...last, patch: { ...last.patch, ...op.patch } }]
+    }
+    if (last.kind === 'upsert' && op.kind === 'update') {
+      return [...outbox.slice(0, -1), { ...last, row: { ...last.row, ...op.patch } }]
+    }
+  }
+  return [...outbox, op]
+}
diff --git a/src/data/schema.ts b/src/data/schema.ts
new file mode 100644
index 0000000..0fe060a
--- /dev/null
+++ b/src/data/schema.ts
@@ -0,0 +1,126 @@
+/**
+ * Row shapes exactly as stored in Postgres (snake_case), plus per-table sync
+ * metadata. See supabase/migrations for the authoritative schema.
+ */
+import type { AccentId, DateKey, SpendingCategory } from '../state/types'
+
+export type HabitRow = {
+  id: string
+  user_id: string
+  name: string
+  accent: AccentId
+  created_on: DateKey
+  archived_on: DateKey | null
+}
+export type CompletionRow = {
+  id: string
+  user_id: string
+  habit_id: string
+  date: DateKey
+}
+export type MilestoneRow = {
+  user_id: string
+  milestone_key: string
+  reached_on: DateKey
+}
+export type ObservationRow = {
+  user_id: string
+  date: DateKey
+  critical_thinking_text: string
+  observations_text: string
+}
+export type MealRow = {
+  user_id: string
+  date: DateKey
+  meal_number: number
+  is_completed: boolean
+  notes: string
+}
+export type WorkoutRow = {
+  user_id: string
+  week_start_date: DateKey
+  workout_count: number
+}
+export type SpendingRow = {
+  id: string
+  user_id: string
+  date: DateKey
+  amount: number
+  description: string
+  category: SpendingCategory
+}
+
+export interface RowMap {
+  habits: HabitRow
+  habit_completions: CompletionRow
+  milestones: MilestoneRow
+  daily_observations: ObservationRow
+  meals: MealRow
+  workouts: WorkoutRow
+  non_essential_spendings: SpendingRow
+}
+export type TableName = keyof RowMap
+/** Any row, possibly partial (patches), as it travels through the sync layer. */
+export type AnyRow = Record<string, unknown>
+
+interface TableSpec {
+  /** Columns that identify a row. `id` for id tables, else the natural key (minus user_id). */
+  key: string[]
+  /** Postgres conflict target used for upserts. */
+  onConflict: string
+  /** Columns fetched from the server. */
+  columns: string
+}
+
+export const TABLES: Record<TableName, TableSpec> = {
+  habits: { key: ['id'], onConflict: 'id', columns: 'id,user_id,name,accent,created_on,archived_on' },
+  habit_completions: { key: ['id'], onConflict: 'id', columns: 'id,user_id,habit_id,date' },
+  milestones: {
+    key: ['milestone_key'],
+    onConflict: 'user_id,milestone_key',
+    columns: 'user_id,milestone_key,reached_on',
+  },
+  daily_observations: {
+    key: ['date'],
+    onConflict: 'user_id,date',
+    columns: 'id,user_id,date,critical_thinking_text,observations_text',
+  },
+  meals: {
+    key: ['date', 'meal_number'],
+    onConflict: 'user_id,date,meal_number',
+    columns: 'id,user_id,date,meal_number,is_completed,notes',
+  },
+  workouts: {
+    key: ['week_start_date'],
+    onConflict: 'user_id,week_start_date',
+    columns: 'id,user_id,week_start_date,workout_count',
+  },
+  non_essential_spendings: {
+    key: ['id'],
+    onConflict: 'id',
+    columns: 'id,user_id,date,amount,description,category',
+  },
+}
+
+export const TABLE_NAMES = Object.keys(TABLES) as TableName[]
+
+/** Tables whose rows are identified by a natural key rather than `id`. */
+export const usesNaturalKey = (t: TableName) => TABLES[t].key[0] !== 'id'
+
+export function rowKey(table: TableName, row: AnyRow): string {
+  return TABLES[table].key.map((c) => String(row[c])).join('|')
+}
+
+export type TableStore = { [T in TableName]: Record<string, RowMap[T]> }
+
+export const emptyTables = (): TableStore => ({
+  habits: {},
+  habit_completions: {},
+  milestones: {},
+  daily_observations: {},
+  meals: {},
+  workouts: {},
+  non_essential_spendings: {},
+})
+
+export type Snapshot = { [T in TableName]: RowMap[T][] }
